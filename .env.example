# Supabase (auto-populated by Lovable)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Cloudflare Turnstile (portal de ingresos). Sitio key pública del widget.
# Si no se setea, en desarrollo se usa la testing key y se omite la verificación.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# NEVER expose service_role in the client!
# SUPABASE_SERVICE_ROLE_KEY is only available in Edge Functions via Deno.env
#
# En Cloudflare Pages > Settings > Environment variables (runtime):
#   TURNSTILE_SECRET_KEY  (clave secreta del sitio de Turnstile)
#   SUPABASE_URL          (https://zgzqeusbpobrwanvktyz.supabase.co)
#   SUPABASE_ANON_KEY     (la misma anon key del proyecto)
